---
import config from "@/config/config.json" assert { type: "json" };
import ImageMod from "../ImageMod.astro";
const { siteTitleHref } = Astro.locals.starlightRoute;

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;

const theme_switcher = config.settings.theme_switcher;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const lightSrc = src || logo;
const darkSrc = srcDarkmode || logo_darkmode;
const hasMark = Boolean(lightSrc || darkSrc);
const brandText = logo_text || title;
const markWidth = Number(String(logo_width || "32").replace("px", ""));
const markHeight = Number(String(logo_height || "32").replace("px", ""));
---

<a href={siteTitleHref} class="navbar-brand inline-flex items-center gap-2">
  {
    hasMark && (
      <>
        <ImageMod
          src={lightSrc}
          class={`inline-block shrink-0 ${theme_switcher && darkSrc ? "dark:hidden" : ""}`}
          width={markWidth * 2}
          height={markHeight * 2}
          alt={brandText}
          style={{
            height: markHeight + "px",
            width: markWidth + "px",
          }}
          format="webp"
        />
        {theme_switcher && darkSrc && (
          <ImageMod
            src={darkSrc}
            class={`hidden dark:inline-block shrink-0`}
            width={markWidth * 2}
            height={markHeight * 2}
            alt={brandText}
            style={{
              height: markHeight + "px",
              width: markWidth + "px",
            }}
            format="webp"
          />
        )}
      </>
    )
  }
  {brandText && <span class="brand-text">{brandText}</span>}
</a>

<style>
  .navbar-brand {
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }
  .brand-text {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
</style>
